generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssetStatus {
  REQUESTED
  APPROVED
  ORDERED
  RECEIVED
  IN_STOCK
  ASSIGNED
  UNDER_MAINTENANCE
  REPAIRED
  RETIRED
  DISPOSED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AllocationStatus {
  AVAILABLE
  ASSIGNED
  RESERVED
  DAMAGED
  UNDER_REPAIR
  RETURNED
}

enum StockTransactionType {
  INWARD
  OUTWARD
  RESERVATION
  ASSIGNMENT
  RETURN
  ADJUSTMENT
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum RecordSource {
  MANUAL
  IMPORT
  INTEGRATION
}

model Organization {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String                @db.VarChar(200)
  slug                  String                @unique @db.VarChar(100)
  createdAt             DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(6)
  users                 User[]
  roles                 Role[]
  permissions           Permission[]
  userRoleLinks         UserRole[]
  rolePermissionLinks   RolePermission[]
  departments           Department[]
  employees             Employee[]
  locations             Location[]
  categories            AssetCategory[]
  vendors               Vendor[]
  assets                Asset[]
  assetSpecs            AssetSpecs[]
  assignments           AssetAssignment[]
  statusHistory         AssetStatusHistory[]
  maintenances          AssetMaintenance[]
  warranties            Warranty[]
  assetPurchases        AssetPurchase[]
  invoices              Invoice[]
  firewalls             Firewall[]
  firewallUsers         FirewallUser[]
  firewallUserGroups    FirewallUserGroup[]
  firewallUserPolicies  FirewallUserPolicy[]
  vpnUsers              VpnUser[]
  macBindings           MacBinding[]
  groups                FirewallGroup[]
  policies              BandwidthPolicy[]
  vlans                 Vlan[]
  ipAllocations         IpAllocation[]
  networkDevices        NetworkDevice[]
  firewallImportBatches FirewallImportBatch[]
  inventory             Inventory[]
  stockEntries          StockTransaction[]
  purchaseOrders        PurchaseOrder[]
  purchaseItems         PurchaseItem[]
  software              SoftwareProduct[]
  licenses              SoftwareLicense[]
  licenseRenewals       LicenseRenewal[]
  expenses              ItExpense[]
  budgets               Budget[]
  depreciations         AssetDepreciation[]
  tickets               SupportTicket[]
  auditLogs             AuditLog[]
  attachments           Attachment[]
  importJobs            ImportJob[]
  importErrors          ImportError[]
  notifications         Notification[]
  savedReports          SavedReport[]
  settings              SystemSetting[]
  licenseAssignments    LicenseAssignment[]
}

model User {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  authUserId     String               @unique @db.Uuid
  email          String               @db.VarChar(320)
  displayName    String               @db.VarChar(200)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles      UserRole[]
  assignments    AssetAssignment[]
  statusChanges  AssetStatusHistory[]
  auditLogs      AuditLog[]
  createdTickets SupportTicket[]      @relation("TicketCreator")

  @@unique([organizationId, email])
  @@index([organizationId, isActive])
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  name            String           @db.VarChar(100)
  description     String?          @db.VarChar(500)
  isSystem        Boolean          @default(false)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  key             String           @db.VarChar(120)
  description     String?          @db.VarChar(500)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]

  @@unique([organizationId, key])
}

model UserRole {
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  roleId         String       @db.Uuid
  assignedAt     DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([organizationId])
}

model RolePermission {
  organizationId String       @db.Uuid
  roleId         String       @db.Uuid
  permissionId   String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([organizationId])
}

model Department {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(150)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees      Employee[]
  assets         Asset[]

  @@unique([organizationId, name])
}

model Employee {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  employeeCode       String              @db.VarChar(80)
  firstName          String              @db.VarChar(100)
  lastName           String              @db.VarChar(100)
  email              String?             @db.VarChar(320)
  departmentId       String?             @db.Uuid
  locationId         String?             @db.Uuid
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  location           Location?           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  assets             Asset[]
  assignments        AssetAssignment[]
  networkDevices     NetworkDevice[]
  licenseAssignments LicenseAssignment[]
  firewallUsers      FirewallUser[]
  vpnUsers           VpnUser[]
  macBindings        MacBinding[]
  ipAllocations      IpAllocation[]
  tickets            SupportTicket[]     @relation("TicketTechnician")

  @@unique([organizationId, employeeCode])
  @@index([organizationId, departmentId])
  @@index([organizationId, lastName, firstName])
}

model Location {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String          @db.VarChar(150)
  address        String?         @db.VarChar(500)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees      Employee[]
  assets         Asset[]
  firewalls      Firewall[]
  networkDevices NetworkDevice[]

  @@unique([organizationId, name])
}

model AssetCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(120)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assets         Asset[]
  inventory      Inventory[]

  @@unique([organizationId, name])
}

model Vendor {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  name           String             @db.VarChar(200)
  email          String?            @db.VarChar(320)
  phone          String?            @db.VarChar(50)
  notes          String?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assets         Asset[]
  maintenances   AssetMaintenance[]
  warranties     Warranty[]
  purchaseOrders PurchaseOrder[]
  licenses       SoftwareLicense[]
  expenses       ItExpense[]

  @@unique([organizationId, name])
}

model Asset {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  assetTag       String               @db.VarChar(100)
  categoryId     String               @db.Uuid
  brand          String?              @db.VarChar(120)
  model          String?              @db.VarChar(150)
  serialNumber   String?              @db.VarChar(150)
  macAddress     String?              @db.VarChar(17)
  ipAddress      String?              @db.VarChar(45)
  purchaseDate   DateTime?            @db.Date
  purchasePrice  Decimal?             @db.Decimal(14, 2)
  vendorId       String?              @db.Uuid
  warrantyStart  DateTime?            @db.Date
  warrantyEnd    DateTime?            @db.Date
  employeeId     String?              @db.Uuid
  departmentId   String?              @db.Uuid
  locationId     String?              @db.Uuid
  condition      AssetCondition       @default(NEW)
  status         AssetStatus          @default(IN_STOCK)
  notes          String?
  archivedAt     DateTime?            @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category       AssetCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendor         Vendor?              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  employee       Employee?            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  department     Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  location       Location?            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  specs          AssetSpecs?
  assignments    AssetAssignment[]
  statusHistory  AssetStatusHistory[]
  maintenances   AssetMaintenance[]
  warranties     Warranty[]
  assetPurchases AssetPurchase[]
  networkDevice  NetworkDevice?
  depreciations  AssetDepreciation[]
  purchaseItems  PurchaseItem[]
  tickets        SupportTicket[]
  attachments    Attachment[]
  macBindings    MacBinding[]

  @@unique([organizationId, assetTag])
  @@unique([organizationId, serialNumber])
  @@index([organizationId, categoryId, status])
  @@index([organizationId, employeeId])
  @@index([organizationId, warrantyEnd])
}

model AssetSpecs {
  organizationId  String       @db.Uuid
  assetId         String       @id @db.Uuid
  processor       String?      @db.VarChar(200)
  ram             String?      @db.VarChar(100)
  storage         String?      @db.VarChar(100)
  operatingSystem String?      @db.VarChar(150)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset           Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model AssetAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  assetId        String       @db.Uuid
  employeeId     String       @db.Uuid
  assignedById   String?      @db.Uuid
  assignedAt     DateTime     @default(now()) @db.Timestamptz(6)
  returnedAt     DateTime?    @db.Timestamptz(6)
  remarks        String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedBy     User?        @relation(fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([organizationId, assetId, returnedAt])
  @@index([organizationId, employeeId, returnedAt])
}

model AssetStatusHistory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  assetId        String       @db.Uuid
  previousStatus AssetStatus?
  newStatus      AssetStatus
  changedById    String?      @db.Uuid
  changedAt      DateTime     @default(now()) @db.Timestamptz(6)
  remarks        String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  changedBy      User?        @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([organizationId, assetId, changedAt])
}

model AssetMaintenance {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  assetId        String       @db.Uuid
  vendorId       String?      @db.Uuid
  issue          String
  repairCost     Decimal?     @db.Decimal(14, 2)
  startedAt      DateTime     @default(now()) @db.Timestamptz(6)
  completedAt    DateTime?    @db.Timestamptz(6)
  resolution     String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  vendor         Vendor?      @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([organizationId, assetId, startedAt])
}

model Warranty {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  assetId        String       @db.Uuid
  vendorId       String?      @db.Uuid
  startsAt       DateTime     @db.Date
  expiresAt      DateTime     @db.Date
  reference      String?      @db.VarChar(150)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  vendor         Vendor?      @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([organizationId, expiresAt])
}

model AssetPurchase {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  assetId        String       @db.Uuid
  purchaseItemId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  purchaseItem   PurchaseItem @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)

  @@unique([organizationId, assetId, purchaseItemId])
}

model Invoice {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  purchaseOrderId String?        @db.Uuid
  invoiceNumber   String         @db.VarChar(100)
  issuedAt        DateTime?      @db.Date
  amount          Decimal        @db.Decimal(14, 2)
  storagePath     String?        @db.VarChar(500)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@unique([organizationId, invoiceNumber])
}

model NetworkDevice {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  assetId        String?      @unique @db.Uuid
  employeeId     String?      @db.Uuid
  locationId     String?      @db.Uuid
  name           String       @db.VarChar(150)
  deviceType     String       @db.VarChar(80)
  managementIp   String?      @db.VarChar(45)
  macAddress     String?      @db.VarChar(17)
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset          Asset?       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  @@index([organizationId, managementIp])
}

model Firewall {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  name           String                @db.VarChar(150)
  manufacturer   String?               @db.VarChar(120)
  model          String?               @db.VarChar(150)
  managementIp   String?               @db.VarChar(45)
  locationId     String?               @db.Uuid
  firmware       String?               @db.VarChar(100)
  notes          String?
  source         RecordSource          @default(MANUAL)
  lastUpdatedAt  DateTime              @default(now()) @db.Timestamptz(6)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location       Location?             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  firewallUsers  FirewallUser[]
  vpnUsers       VpnUser[]
  macBindings    MacBinding[]
  groups         FirewallGroup[]
  ipAllocations  IpAllocation[]
  importBatches  FirewallImportBatch[]

  @@unique([organizationId, name])
  @@index([organizationId, managementIp])
}

model FirewallUser {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  firewallId     String               @db.Uuid
  username       String               @db.VarChar(150)
  employeeId     String?              @db.Uuid
  ipAddress      String?              @db.VarChar(45)
  macAddress     String?              @db.VarChar(17)
  status         String               @default("ACTIVE") @db.VarChar(30)
  expiresAt      DateTime?            @db.Date
  source         RecordSource         @default(MANUAL)
  lastUpdatedAt  DateTime             @default(now()) @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  firewall       Firewall             @relation(fields: [firewallId], references: [id], onDelete: Restrict)
  employee       Employee?            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  memberships    FirewallUserGroup[]
  policyLinks    FirewallUserPolicy[]

  @@unique([organizationId, firewallId, username])
  @@index([organizationId, employeeId])
}

model VpnUser {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  firewallId     String?      @db.Uuid
  username       String       @db.VarChar(150)
  employeeId     String?      @db.Uuid
  vpnType        String?      @db.VarChar(80)
  assignedIp     String?      @db.VarChar(45)
  status         String       @default("ACTIVE") @db.VarChar(30)
  accessStartsAt DateTime?    @db.Date
  expiresAt      DateTime?    @db.Date
  source         RecordSource @default(MANUAL)
  lastUpdatedAt  DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  firewall       Firewall?    @relation(fields: [firewallId], references: [id], onDelete: Restrict)
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, username])
  @@index([organizationId, expiresAt])
}

model MacBinding {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  firewallId     String?      @db.Uuid
  assetId        String?      @db.Uuid
  employeeId     String?      @db.Uuid
  macAddress     String       @db.VarChar(17)
  ipAddress      String       @db.VarChar(45)
  deviceName     String?      @db.VarChar(150)
  status         String       @default("ACTIVE") @db.VarChar(30)
  source         RecordSource @default(MANUAL)
  lastUpdatedAt  DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  firewall       Firewall?    @relation(fields: [firewallId], references: [id], onDelete: Restrict)
  asset          Asset?       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, macAddress, ipAddress])
  @@index([organizationId, ipAddress])
}

model FirewallGroup {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  firewallId     String              @db.Uuid
  name           String              @db.VarChar(150)
  description    String?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  firewall       Firewall            @relation(fields: [firewallId], references: [id], onDelete: Restrict)
  members        FirewallUserGroup[]

  @@unique([organizationId, firewallId, name])
}

model FirewallUserGroup {
  organizationId String        @db.Uuid
  firewallUserId String        @db.Uuid
  groupId        String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  firewallUser   FirewallUser  @relation(fields: [firewallUserId], references: [id], onDelete: Cascade)
  group          FirewallGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([firewallUserId, groupId])
  @@index([organizationId])
}

model BandwidthPolicy {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  name           String               @db.VarChar(150)
  downloadMbps   Decimal?             @db.Decimal(10, 2)
  uploadMbps     Decimal?             @db.Decimal(10, 2)
  description    String?
  isActive       Boolean              @default(true)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userLinks      FirewallUserPolicy[]

  @@unique([organizationId, name])
}

model FirewallUserPolicy {
  organizationId String          @db.Uuid
  firewallUserId String          @db.Uuid
  policyId       String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  firewallUser   FirewallUser    @relation(fields: [firewallUserId], references: [id], onDelete: Cascade)
  policy         BandwidthPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@id([firewallUserId, policyId])
  @@index([organizationId])
}

model Vlan {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String         @db.VarChar(100)
  vlanId         Int
  subnet         String?        @db.VarChar(50)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ipAllocations  IpAllocation[]

  @@unique([organizationId, vlanId])
}

model IpAllocation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  firewallId     String?      @db.Uuid
  address        String       @db.VarChar(45)
  subnet         String?      @db.VarChar(50)
  vlanId         String?      @db.Uuid
  deviceName     String?      @db.VarChar(150)
  employeeId     String?      @db.Uuid
  status         String       @default("AVAILABLE") @db.VarChar(30)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  firewall       Firewall?    @relation(fields: [firewallId], references: [id], onDelete: Restrict)
  vlan           Vlan?        @relation(fields: [vlanId], references: [id], onDelete: Restrict)
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, address])
  @@index([organizationId, status])
}

model FirewallImportBatch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  firewallId     String?      @db.Uuid
  fileName       String       @db.VarChar(255)
  importedRows   Int          @default(0)
  failedRows     Int          @default(0)
  importedAt     DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  firewall       Firewall?    @relation(fields: [firewallId], references: [id], onDelete: Restrict)

  @@index([organizationId, importedAt])
}

model Inventory {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  categoryId      String             @db.Uuid
  sku             String?            @db.VarChar(100)
  description     String             @db.VarChar(300)
  quantity        Int                @default(0)
  minimumQuantity Int                @default(0)
  unitPrice       Decimal?           @db.Decimal(14, 2)
  archivedAt      DateTime?          @db.Timestamptz(6)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category        AssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions    StockTransaction[]

  @@unique([organizationId, sku])
  @@index([organizationId, categoryId])
}

model StockTransaction {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  inventoryId    String               @db.Uuid
  type           StockTransactionType
  quantity       Int
  reference      String?              @db.VarChar(150)
  remarks        String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventory      Inventory            @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([organizationId, inventoryId, createdAt])
}

model PurchaseOrder {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  orderNumber    String         @db.VarChar(100)
  vendorId       String         @db.Uuid
  purchaseDate   DateTime       @db.Date
  invoiceNumber  String?        @db.VarChar(100)
  paymentStatus  PaymentStatus  @default(UNPAID)
  deliveryDate   DateTime?      @db.Date
  taxAmount      Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal        @default(0) @db.Decimal(14, 2)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vendor         Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items          PurchaseItem[]
  invoices       Invoice[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, purchaseDate])
}

model PurchaseItem {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  purchaseOrderId String          @db.Uuid
  assetId         String?         @db.Uuid
  description     String          @db.VarChar(300)
  category        String?         @db.VarChar(120)
  model           String?         @db.VarChar(150)
  quantity        Int
  unitPrice       Decimal         @db.Decimal(14, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(14, 2)
  warrantyMonths  Int?
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  asset           Asset?          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assetPurchases  AssetPurchase[]

  @@index([organizationId, purchaseOrderId])
}

model SoftwareProduct {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  name           String            @db.VarChar(200)
  publisher      String?           @db.VarChar(150)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  licenses       SoftwareLicense[]

  @@unique([organizationId, name, publisher])
}

model SoftwareLicense {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @db.Uuid
  softwareProductId String              @db.Uuid
  vendorId          String?             @db.Uuid
  licenseType       String              @db.VarChar(100)
  totalSeats        Int
  availableSeats    Int
  purchasedAt       DateTime?           @db.Date
  expiresAt         DateTime?           @db.Date
  renewalCost       Decimal?            @db.Decimal(14, 2)
  status            LicenseStatus       @default(ACTIVE)
  secretReference   String?             @db.VarChar(300)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  softwareProduct   SoftwareProduct     @relation(fields: [softwareProductId], references: [id], onDelete: Restrict)
  vendor            Vendor?             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  assignments       LicenseAssignment[]
  renewals          LicenseRenewal[]

  @@index([organizationId, expiresAt])
}

model LicenseAssignment {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  licenseId      String          @db.Uuid
  employeeId     String          @db.Uuid
  assignedAt     DateTime        @default(now()) @db.Timestamptz(6)
  returnedAt     DateTime?       @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  license        SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, licenseId, returnedAt])
}

model LicenseRenewal {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  licenseId      String          @db.Uuid
  renewedAt      DateTime        @db.Date
  expiresAt      DateTime        @db.Date
  cost           Decimal?        @db.Decimal(14, 2)
  notes          String?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  license        SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Restrict)

  @@index([organizationId, expiresAt])
}

model ItExpense {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  vendorId       String?      @db.Uuid
  category       String       @db.VarChar(100)
  description    String       @db.VarChar(300)
  amount         Decimal      @db.Decimal(14, 2)
  incurredAt     DateTime     @db.Date
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vendor         Vendor?      @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([organizationId, incurredAt])
}

model Budget {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(150)
  fiscalYear     Int
  amount         Decimal      @db.Decimal(14, 2)
  departmentId   String?      @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name, fiscalYear])
}

model AssetDepreciation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  assetId        String       @db.Uuid
  calculatedAt   DateTime     @db.Date
  bookValue      Decimal      @db.Decimal(14, 2)
  method         String       @db.VarChar(50)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([organizationId, assetId, calculatedAt])
}

model SupportTicket {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  ticketNumber   String         @db.VarChar(100)
  assetId        String?        @db.Uuid
  createdById    String         @db.Uuid
  technicianId   String?        @db.Uuid
  issue          String
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  repairCost     Decimal?       @db.Decimal(14, 2)
  resolution     String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  resolvedAt     DateTime?      @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset          Asset?         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  technician     Employee?      @relation("TicketTechnician", fields: [technicianId], references: [id], onDelete: Restrict)

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status, priority])
}

model SavedReport {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(150)
  reportType     String       @db.VarChar(100)
  filters        Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  action         String       @db.VarChar(100)
  module         String       @db.VarChar(100)
  recordId       String?      @db.Uuid
  previousValues Json?
  newValues      Json?
  ipAddress      String?      @db.VarChar(45)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, module, recordId])
}

model Attachment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  assetId        String?      @db.Uuid
  storagePath    String       @db.VarChar(500)
  fileName       String       @db.VarChar(255)
  contentType    String       @db.VarChar(150)
  sizeBytes      BigInt
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset          Asset?       @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([organizationId, assetId])
}

model ImportJob {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  module         String        @db.VarChar(100)
  fileName       String        @db.VarChar(255)
  status         String        @default("PENDING") @db.VarChar(30)
  totalRows      Int           @default(0)
  importedRows   Int           @default(0)
  failedRows     Int           @default(0)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  errors         ImportError[]

  @@index([organizationId, createdAt])
}

model ImportError {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  importJobId    String       @db.Uuid
  rowNumber      Int
  field          String?      @db.VarChar(150)
  message        String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importJob      ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, rowNumber])
}

model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  category       String       @db.VarChar(80)
  eventKey       String       @db.VarChar(200)
  title          String       @db.VarChar(200)
  message        String
  readAt         DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, eventKey])
  @@index([organizationId, readAt, createdAt])
}

model SystemSetting {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  key            String       @db.VarChar(150)
  value          Json
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
}
