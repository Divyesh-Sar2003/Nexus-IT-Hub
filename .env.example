# Supabase project URL and publishable key (safe for browser use; never use a service-role key here).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Prisma runtime connection: Supabase pooler in transaction mode.
DATABASE_URL=postgresql://postgres.your-project:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Prisma migrations: direct Supabase database connection.
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres
